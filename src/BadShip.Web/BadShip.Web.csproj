<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- BadShip.Core compiled to WebAssembly for the browser shipyard page: the same generator, running client-side. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>false</WasmEnableThreads>
    <RootNamespace>BadShip.Web</RootNamespace>
    <!-- The core serialises anonymous types by reflection: keep the core assembly whole (below) and reflection on. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <CompressionEnabled>false</CompressionEnabled>
    <DebugType>none</DebugType>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CA1416;IL2026</NoWarn>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="BadShip.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BadShip.Core\BadShip.Core.csproj" />
  </ItemGroup>

</Project>
